extends Node2D

const PLAYER_SCENE := preload("res://Scenes/Player.tscn")
const BOMB_SCENE := preload("res://Scenes/Bomb.tscn")
const PICKUP_SCENE := preload("res://Scenes/Pickup.tscn")

const ARENA_MIN := Vector2(90.0, 90.0)
const ARENA_MAX := Vector2(1190.0, 630.0)
const MAX_ACTIVE_BOMBS := 20
const STARTING_BOMBS := 8
const STARTING_PICKUPS := 2

var players: Array = []
var bombs: Array = []
var pickups: Array = []
var match_timer: float = 0.0
var game_over: bool = false
var bomb_spawn_timer: float = 0.0
var pickup_spawn_timer: float = 3.0
var start_delay: float = 1.2

var hud_root: Control
var timer_label: Label
var status_label: Label
var p1_status: Label
var p2_status: Label
var ability_buttons: Array = []

func _ready() -> void:
    _build_hud()
    _spawn_players()
    _spawn_initial_bombs()
    _update_hud()

func _process(delta: float) -> void:
    if game_over:
        return

    if start_delay > 0.0:
        start_delay -= delta
        timer_label.text = "READY"
        return

    match_timer += delta
    bomb_spawn_timer -= delta
    pickup_spawn_timer -= delta

    if bomb_spawn_timer <= 0.0:
        if bombs.size() < MAX_ACTIVE_BOMBS:
            _spawn_bomb()
        bomb_spawn_timer = 0.6

    if pickup_spawn_timer <= 0.0:
        if pickups.size() < STARTING_PICKUPS:
            _spawn_pickup()
        pickup_spawn_timer = 6.0

    _update_hud()

func _build_hud() -> void:
    var canvas := CanvasLayer.new()
    add_child(canvas)

    hud_root = Control.new()
    hud_root.set_anchors_preset(Control.PRESET_FULL_RECT)
    hud_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
    canvas.add_child(hud_root)

    var arena_bg := ColorRect.new()
    arena_bg.set_anchors_preset(Control.PRESET_FULL_RECT)
    arena_bg.color = Color("#071426")
    hud_root.add_child(arena_bg)

    var border := ColorRect.new()
    border.position = Vector2(40, 40)
    border.size = Vector2(1200, 640)
    border.color = Color("#4DA6FF")
    border.z_index = 1
    hud_root.add_child(border)

    timer_label = Label.new()
    timer_label.anchor_left = 0.5
    timer_label.anchor_right = 0.5
    timer_label.position = Vector2(-180, 12)
    timer_label.size = Vector2(360, 42)
    timer_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    timer_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    timer_label.add_theme_font_size_override("font_size", 30)
    timer_label.add_theme_color_override("font_color", Color("#FFFFFF"))
    hud_root.add_child(timer_label)

    status_label = Label.new()
    status_label.anchor_left = 0.5
    status_label.anchor_right = 0.5
    status_label.position = Vector2(-220, 58)
    status_label.size = Vector2(440, 30)
    status_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    status_label.add_theme_font_size_override("font_size", 18)
    status_label.add_theme_color_override("font_color", Color("#B8D9FF"))
    hud_root.add_child(status_label)

    p1_status = Label.new()
    p1_status.position = Vector2(56, 54)
    p1_status.size = Vector2(260, 26)
    p1_status.add_theme_font_size_override("font_size", 18)
    p1_status.add_theme_color_override("font_color", Color("#FFFFFF"))
    hud_root.add_child(p1_status)

    p2_status = Label.new()
    p2_status.position = Vector2(56, 82)
    p2_status.size = Vector2(260, 26)
    p2_status.add_theme_font_size_override("font_size", 18)
    p2_status.add_theme_color_override("font_color", Color("#FFFFFF"))
    hud_root.add_child(p2_status)

func _spawn_players() -> void:
    var p1 := PLAYER_SCENE.instantiate()
    p1.position = Vector2(250, 360)
    p1.configure("Player 1", "p1", Global.player_1_color)
    p1.add_to_group("players")
    add_child(p1)
    players.append(p1)

    if Global.game_mode == "versus":
        var p2 := PLAYER_SCENE.instantiate()
        p2.position = Vector2(1030, 360)
        p2.configure("Player 2", "p2", Global.player_2_color)
        p2.add_to_group("players")
        add_child(p2)
        players.append(p2)

    _build_ability_hud()

func _build_ability_hud() -> void:
    for child in ability_buttons:
        if is_instance_valid(child):
            child.queue_free()
    ability_buttons.clear()

    for i in range(players.size()):
        var player = players[i]
        var button := Button.new()
        button.text = ""
        button.custom_minimum_size = Vector2(120, 42)
        button.modulate = Color("#164B83")
        button.add_theme_color_override("font_color", Color("#F2F9FF"))
        button.add_theme_font_size_override("font_size", 18)
        button.position = Vector2(56 + i * 150, 110)
        button.size = Vector2(120, 42)
        button.visible = false
        button.gui_input.connect(func(event: InputEvent):
            if event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.double_click:
                if player.ability_inventory != "none":
                    player.use_ability()
                    _update_ability_hud()
        )
        hud_root.add_child(button)
        ability_buttons.append(button)

    _update_ability_hud()

func _update_ability_hud() -> void:
    for i in range(players.size()):
        var player = players[i]
        var button = ability_buttons[i]
        if player.ability_inventory == "none":
            button.visible = false
            button.text = ""
            continue

        button.visible = true
        button.text = player.ability_inventory.to_upper()
        if player.ability_inventory == "dash":
            button.modulate = Color("#FF3B30")
        else:
            button.modulate = Color("#1677FF")

        if player.ability_inventory == "shield":
            if player.shield_timer > 0.0:
                button.text = "SHIELD %0.1f" % max(0.0, player.shield_timer)
            else:
                button.text = "SHIELD"
        elif player.ability_inventory == "dash":
            if player.dash_cooldown > 0.0:
                button.text = "DASH %0.1f" % max(0.0, player.dash_cooldown)
            else:
                button.text = "DASH"

func _spawn_initial_bombs() -> void:
    for i in range(STARTING_BOMBS):
        _spawn_bomb()

func _spawn_bomb() -> void:
    if bombs.size() >= MAX_ACTIVE_BOMBS:
        return

    var bomb := BOMB_SCENE.instantiate()
    bomb.position = _random_valid_position_for_bomb()
    bomb.blast_radius = 200.0
    add_child(bomb)
    bombs.append(bomb)
    bomb.exploded.connect(_on_bomb_exploded)

func _spawn_pickup() -> void:
    if pickups.size() >= STARTING_PICKUPS:
        return

    var pickup := PICKUP_SCENE.instantiate()
    pickup.position = _random_valid_position_for_pickup()
    pickup.set_kind("dash" if randi() % 2 == 0 else "shield")
    add_child(pickup)
    pickups.append(pickup)
    pickup.collected.connect(_on_pickup_collected)

func _random_valid_position_for_bomb() -> Vector2:
    for attempt in range(300):
        var candidate := Vector2(randf_range(ARENA_MIN.x, ARENA_MAX.x), randf_range(ARENA_MIN.y, ARENA_MAX.y))
        var blocked := false

        for player in players:
            if player.global_position.distance_to(candidate) < 120.0:
                blocked = true
                break

        for bomb in bombs:
            if bomb.global_position.distance_to(candidate) < 70.0:
                blocked = true
                break

        for pickup in pickups:
            if pickup.global_position.distance_to(candidate) < 60.0:
                blocked = true
                break

        if not blocked:
            return candidate

    return Vector2(640, 360)

func _random_valid_position_for_pickup() -> Vector2:
    for attempt in range(300):
        var candidate := Vector2(randf_range(ARENA_MIN.x, ARENA_MAX.x), randf_range(ARENA_MIN.y, ARENA_MAX.y))
        var blocked := false

        for player in players:
            if player.global_position.distance_to(candidate) < 110.0:
                blocked = true
                break

        for bomb in bombs:
            if bomb.global_position.distance_to(candidate) < 80.0:
                blocked = true
                break

        for pickup in pickups:
            if pickup.global_position.distance_to(candidate) < 70.0:
                blocked = true
                break

        if not blocked:
            return candidate

    return Vector2(640, 360)

func _on_bomb_exploded(bomb: Node) -> void:
    if not bombs.has(bomb):
        return
    bombs.erase(bomb)

    for player in players:
        if not player.is_alive:
            continue

        var distance := player.global_position.distance_to(bomb.global_position)
        if distance <= bomb.blast_radius:
            var direction := (player.global_position - bomb.global_position).normalized()
            if direction == Vector2.ZERO:
                direction = Vector2.RIGHT
            if player.has_shield():
                player.consume_shield()
            else:
                player.eliminate()
            player.apply_explosion_knockback(direction, (1.0 - distance / bomb.blast_radius) * 900.0)

    _check_game_result()

func _on_pickup_collected(kind: String, pickup: Node) -> void:
    if pickups.has(pickup):
        pickups.erase(pickup)

func _check_game_result() -> void:
    if game_over:
        return

    var alive_players := []
    for player in players:
        if player.is_alive:
            alive_players.append(player)

    if Global.game_mode == "solo":
        if alive_players.size() == 0:
            game_over = true
            _show_results("Game Over\nSurvived " + _format_time(match_timer), ["Restart", "Main Menu"])
    else:
        if alive_players.size() == 0:
            game_over = true
            _show_results("Draw!", ["Restart", "Main Menu"])
        elif alive_players.size() == 1:
            game_over = true
            _show_results(alive_players[0].player_name + " Wins!", ["Restart", "Main Menu"])

func _show_results(title: String, actions: Array) -> void:
    var panel := Panel.new()
    panel.position = Vector2(280, 180)
    panel.size = Vector2(720, 320)
    panel.modulate = Color(0.08, 0.12, 0.2, 0.95)
    hud_root.add_child(panel)

    var label := Label.new()
    label.position = Vector2(0, 70)
    label.size = Vector2(720, 120)
    label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
    label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
    label.add_theme_font_size_override("font_size", 38)
    label.add_theme_color_override("font_color", Color("#FFFFFF"))
    label.text = title
    panel.add_child(label)

    var restart_button := Button.new()
    restart_button.position = Vector2(160, 220)
    restart_button.size = Vector2(170, 60)
    restart_button.text = "Restart"
    restart_button.modulate = Color("#164B83")
    restart_button.pressed.connect(_on_restart_pressed)
    panel.add_child(restart_button)

    var menu_button := Button.new()
    menu_button.position = Vector2(390, 220)
    menu_button.size = Vector2(170, 60)
    menu_button.text = "Main Menu"
    menu_button.modulate = Color("#164B83")
    menu_button.pressed.connect(_on_main_menu_pressed)
    panel.add_child(menu_button)

func _update_hud() -> void:
    var total_seconds := int(match_timer)
    var minutes := total_seconds / 60
    var seconds := total_seconds % 60
    timer_label.text = "%02d:%02d" % [minutes, seconds]

    if Global.game_mode == "solo":
        status_label.text = "Solo Survival"
        if players.size() > 0:
            p1_status.text = "Player 1: " + ("Alive" if players[0].is_alive else "Eliminated")
        p2_status.text = ""
    else:
        status_label.text = "Local Multiplayer"
        if players.size() >= 2:
            p1_status.text = "Player 1: " + ("Alive" if players[0].is_alive else "Eliminated")
            p2_status.text = "Player 2: " + ("Alive" if players[1].is_alive else "Eliminated")

func _format_time(seconds: float) -> String:
    var total := int(seconds)
    return "%02d:%02d" % [total / 60, total % 60]

func _on_restart_pressed() -> void:
    get_tree().reload_current_scene()

func _on_main_menu_pressed() -> void:
    get_tree().change_scene_to_file("res://Scenes/MainMenu.tscn")
